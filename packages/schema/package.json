{
  "name": "@ctw/schema",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contract"
  ],
  "scripts": {
    "sync-contract": "node ../../scripts/sync-contract.mjs",
    "build": "npm run sync-contract && tsc -p tsconfig.json",
    "test": "npm run sync-contract && node --import tsx --test tests/**/*.test.ts",
    "test:coverage": "npm run sync-contract && node --import tsx --experimental-test-coverage --test-coverage-lines=85 --test tests/**/*.test.ts",
    "stryker": "stryker run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
