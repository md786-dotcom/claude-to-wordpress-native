{
  "name": "@ctw/schema",
  "version": "0.2.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contract"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-contract.mjs && tsc -p tsconfig.json",
    "test": "node ../../scripts/sync-contract.mjs && node --import tsx --test tests/**/*.test.ts",
    "test:coverage": "node ../../scripts/sync-contract.mjs && node --import tsx --experimental-test-coverage --test-coverage-lines=85 --test tests/**/*.test.ts",
    "stryker": "stryker run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1"
  }
}
